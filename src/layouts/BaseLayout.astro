---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { siteName } from '../data/profile';
import {
  currentLocale,
  locales,
  openGraphLocale,
  type Locale,
} from '../i18n/locales';
import { toRoutePath } from '../i18n/routes';
import { getUi } from '../i18n/ui';
import { buildJsonLd, type JsonLdNode } from '../seo/jsonld';
import { absoluteLocaleUrl, localeAlternates } from '../seo/urls';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  graph?: JsonLdNode[];
  mainEntityId?: string;
}

const { title, description, locale, graph, mainEntityId } = Astro.props;
const routeLocale = currentLocale(Astro.currentLocale);

if (routeLocale !== locale) {
  throw new Error(
    `Page locale is ${locale}, but the route locale is ${Astro.currentLocale ?? 'missing'}.`,
  );
}

if (!Astro.site) {
  throw new Error(
    'Set site in astro.config.mjs before rendering canonical URLs.',
  );
}

const routePath = toRoutePath(Astro.url.pathname);
const ui = getUi(locale);
const site = Astro.site;
const canonical = absoluteLocaleUrl(site, locale, routePath);
const socialImage = new URL('/og.png', site).href;
const socialImageAlt = ui.sharing.imageAlt;
const alternates = localeAlternates(site, routePath);
const jsonLd = await buildJsonLd({
  site,
  locale,
  canonical,
  title,
  description,
  graph,
  mainEntityId,
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline>
      (function () {
        const stored = readStoredTheme();
        const choice =
          stored === 'system'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
            : stored === 'dark'
              ? 'dark'
              : 'light';

        if (stored === 'system') {
          try {
            localStorage.setItem('theme', choice);
          } catch {
            // Private browsing can block storage. The resolved choice still applies.
          }
        }

        document.documentElement.dataset.theme = choice;

        function readStoredTheme() {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={alternate.href}
      />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={openGraphLocale[locale]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {locales
      .filter((code) => code !== locale)
      .map((code) => (
        <meta property="og:locale:alternate" content={openGraphLocale[code]} />
      ))}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="flex min-h-dvh flex-col bg-background font-sans text-foreground">
    <a class="skip-link" href="#content">
      {ui.skip}
    </a>
    <Header locale={locale} />
    <main id="content" tabindex="-1" class="flex flex-1 flex-col">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
