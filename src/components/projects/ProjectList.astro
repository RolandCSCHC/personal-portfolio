---
import type { CollectionEntry } from 'astro:content';
import type { ProjectCopy } from '../../data/profile';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  labels: ProjectCopy;
  heading: 'h2' | 'h3';
}

const { projects, labels, heading } = Astro.props;
---

<ul class="grid gap-8 lg:grid-cols-2">
  {projects.map((project) => (
    <li class="min-w-0">
      <ProjectCard project={project} labels={labels} heading={heading} />
    </li>
  ))}
</ul>
