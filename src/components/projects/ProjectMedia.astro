---
import { Picture } from 'astro:assets';
import type { ProjectView } from '../../data/projects';

interface Props {
  image: ProjectView['image'];
  unpublished: string;
  sizes: string;
  priority?: boolean;
}

const { image, unpublished, sizes, priority = false } = Astro.props;
---

{image ? (
  <Picture
    src={image.src}
    alt={image.alt}
    widths={[640, 960, 1280, 1600]}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="jpeg"
    quality={80}
    priority={priority}
    class="h-auto w-full border border-border"
    pictureAttributes={{ class: 'block w-full' }}
  />
) : (
  <div class="flex aspect-video items-center justify-center border border-border bg-surface p-6 text-center">
    <p class="text-sm text-muted">{unpublished}</p>
  </div>
)}
