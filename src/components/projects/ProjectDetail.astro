---
import type { ProjectCopy } from '../../data/profile';
import type { ProjectView } from '../../data/projects';
import Section from '../sections/Section.astro';
import ProjectLinks from './ProjectLinks.astro';
import ProjectMedia from './ProjectMedia.astro';
import TechnologyList from './TechnologyList.astro';

interface Props {
  project: ProjectView;
  labels: ProjectCopy;
}

const { project, labels } = Astro.props;
const { name, summary, features, stack, liveUrl, repositories, image } =
  project;
---

<Section id={project.id} title={name} page>
  <div class="grid gap-10">
    <div class="max-w-3xl">
      <ProjectMedia image={image} unpublished={labels.screenshotUnpublished} />
    </div>
    <div class="reading-measure grid gap-10">
      <section aria-labelledby={`${project.id}-overview`}>
        <h2 id={`${project.id}-overview`}>{labels.overview}</h2>
        <p class="mt-3">{summary}</p>
        <div class="mt-6">
          <ProjectLinks
            liveUrl={liveUrl}
            repositories={repositories}
            labels={labels}
          />
        </div>
      </section>
      <section aria-labelledby={`${project.id}-features`}>
        <h2 id={`${project.id}-features`}>{labels.features}</h2>
        <ul class="mt-3 list-disc space-y-1 pl-5">
          {features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
      </section>
      <section aria-labelledby={`${project.id}-stack`}>
        <h2 id={`${project.id}-stack`}>{labels.stack}</h2>
        <div class="mt-3">
          <TechnologyList items={stack} />
        </div>
      </section>
    </div>
  </div>
</Section>
