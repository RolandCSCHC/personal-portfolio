---
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';

const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home', current: pathname === '/' },
  {
    href: '/projects',
    label: 'Projects',
    current: pathname === '/projects' || pathname.startsWith('/projects/'),
  },
  { href: '/about', label: 'About', current: pathname === '/about' },
  {
    href: '/experience',
    label: 'Experience',
    current: pathname === '/experience',
  },
];
---

<header class="border-b border-border bg-surface">
  <div class="page-container flex flex-col gap-4 py-4 lg:flex-row lg:items-center lg:justify-between lg:py-5">
    <a
      href="/"
      class="shrink-0 text-base font-semibold tracking-tight whitespace-nowrap text-foreground no-underline"
    >
      Roland Schlösser
    </a>
    <div class="flex flex-col gap-4 lg:flex-row lg:flex-wrap lg:items-center lg:justify-end lg:gap-x-6 lg:gap-y-3">
      <nav aria-label="Primary">
        <ul class="flex flex-wrap gap-x-4 gap-y-2">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.current ? 'page' : undefined}
                class:list={[
                  'text-foreground no-underline hover:underline',
                  link.current && 'font-semibold underline',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <LanguageSwitch />
      <ThemeSwitch />
    </div>
  </div>
</header>
