---
import { loadProjects } from '../../data/projects';
import type { Locale } from '../../i18n/locales';
import { locales } from '../../i18n/locales';
import { equivalentPath, localeHref, toRoutePath } from '../../i18n/routes';
import { getUi } from '../../i18n/ui';
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const routePath = toRoutePath(Astro.url.pathname);
const projects = await loadProjects();
const slugs = projects.map((project) => project.id);
const homeHref = localeHref(locale, '');
const links = [
  {
    href: homeHref,
    label: ui.nav.home,
    current: routePath === '',
  },
  {
    href: localeHref(locale, 'projects'),
    label: ui.nav.projects,
    current: routePath === 'projects' || routePath.startsWith('projects/'),
  },
  {
    href: localeHref(locale, 'experience'),
    label: ui.nav.experience,
    current: routePath === 'experience',
  },
];
const languageOptions = locales.map((code) => ({
  code,
  label: ui.language.names[code],
  href: equivalentPath(code, Astro.url.pathname, slugs),
  current: code === locale,
}));
---

<header class="border-b border-border bg-surface">
  <div class="h-0.5 bg-accent" aria-hidden="true"></div>
  <div class="page-container flex flex-col gap-4 py-4 lg:flex-row lg:flex-wrap lg:items-center lg:gap-x-6 lg:gap-y-3 lg:py-5">
    <nav aria-label={ui.nav.label}>
      <ul class="flex flex-wrap gap-x-4 gap-y-2">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.current ? 'page' : undefined}
              class:list={[
                'no-underline hover:underline',
                link.current
                  ? 'font-semibold text-accent underline'
                  : 'text-foreground',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <LanguageSwitch label={ui.language.label} options={languageOptions} />
    <ThemeSwitch labels={ui.theme} />
  </div>
</header>
