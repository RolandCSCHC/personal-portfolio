---
import type { Locale } from '../../i18n/locales';

interface Props {
  label: string;
  options: {
    code: Locale;
    label: string;
    href: string;
    current: boolean;
  }[];
}

const { label, options } = Astro.props;
---

<div class="inline-flex items-center gap-2">
  <span id="language-label" class="font-mono text-xs tracking-wide text-muted">
    {label}
  </span>
  <span class="relative inline-flex">
    <select
      class="appearance-none rounded-sm border border-border bg-surface py-1 pr-7 pl-2 text-sm text-foreground"
      aria-labelledby="language-label"
      data-language-control
      autocomplete="off"
    >
      {options.map((option) => (
        <option
          value={option.href}
          lang={option.code}
          selected={option.current}
        >
          {option.label}
        </option>
      ))}
    </select>
    <svg
      class="pointer-events-none absolute top-1/2 right-2 size-3 -translate-y-1/2 text-muted"
      viewBox="0 0 12 12"
      aria-hidden="true"
    >
      <path
        d="M2.5 4.5 6 8l3.5-3.5"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
      ></path>
    </svg>
  </span>
</div>
<script>
  function initLanguageControl(select: HTMLSelectElement): void {
    select.addEventListener('change', () => {
      const next = new URL(select.value, window.location.href);
      if (next.pathname === window.location.pathname) {
        return;
      }

      window.location.assign(`${next.pathname}${window.location.hash}`);
    });
  }

  const select = document.querySelector<HTMLSelectElement>(
    '[data-language-control]',
  );

  if (select) {
    initLanguageControl(select);
  }
</script>
