---
import { contactFacts, copyrightNotice, siteName } from '../../data/profile';
import { loadProjects } from '../../data/projects';
import type { Locale } from '../../i18n/locales';
import { getUi } from '../../i18n/ui';
import PublicLink from '../PublicLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const projects = await loadProjects();
const links = [
  contactFacts.github,
  contactFacts.linkedin,
  contactFacts.email,
].map((link) => ({
  label: link.label,
  href: link.href,
  unpublished: ui.unpublished,
}));
---

<footer class="border-t border-border bg-surface">
  <div class="page-container flex flex-col gap-6 py-8 lg:flex-row lg:justify-between">
    <div class="reading-measure">
      <p class="font-semibold text-foreground">{siteName}</p>
      <p class="text-sm text-muted">{copyrightNotice}</p>
    </div>
    <nav aria-label={ui.footer.contact}>
      <ul class="flex flex-col gap-2 text-sm">
        {links.map((link) => (
          <li>
            <PublicLink link={link} />
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-label={ui.footer.applications}>
      <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {projects.map((project) => (
          <li>
            <PublicLink
              link={{
                label: project.data.name,
                href: project.data.liveUrl,
                unpublished: ui.unpublished,
              }}
            />
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
