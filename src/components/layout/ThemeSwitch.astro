<form data-theme-control autocomplete="off">
  <fieldset class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2 border-0 p-0">
    <legend class="font-mono text-xs tracking-wide text-muted">Theme</legend>
    <label class="inline-flex items-center gap-1.5" for="theme-light">
      <input id="theme-light" type="radio" name="theme" value="light" />
      Light
    </label>
    <label class="inline-flex items-center gap-1.5" for="theme-dark">
      <input id="theme-dark" type="radio" name="theme" value="dark" />
      Dark
    </label>
    <label class="inline-flex items-center gap-1.5" for="theme-system">
      <input id="theme-system" type="radio" name="theme" value="system" />
      System
    </label>
  </fieldset>
</form>

<script>
  import { initThemeControls } from '../../scripts/theme';

  const form = document.querySelector<HTMLFormElement>('[data-theme-control]');

  if (form) {
    initThemeControls(form);
  }
</script>
