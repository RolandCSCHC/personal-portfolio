<div class="inline-flex items-center gap-2">
  <span id="theme-label" class="font-mono text-xs tracking-wide text-muted">
    Theme
  </span>
  <span class="relative inline-flex">
    <select
      class="appearance-none rounded-sm border border-border bg-surface py-1 pr-7 pl-2 text-sm text-foreground"
      aria-labelledby="theme-label"
      data-theme-control
      autocomplete="off"
    >
      <option value="light">Light</option>
      <option value="dark">Dark</option>
      <option value="system">System</option>
    </select>
    <svg
      class="pointer-events-none absolute top-1/2 right-2 size-3 -translate-y-1/2 text-muted"
      viewBox="0 0 12 12"
      aria-hidden="true"
    >
      <path
        d="M2.5 4.5 6 8l3.5-3.5"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
      ></path>
    </svg>
  </span>
</div>
<script is:inline>
  (function () {
    const select = document.querySelector('[data-theme-control]');
    const choice = document.documentElement.dataset.themeChoice;

    if (
      select instanceof HTMLSelectElement &&
      (choice === 'light' || choice === 'dark' || choice === 'system')
    ) {
      select.value = choice;
    }
  })();
</script>
<script>
  import { initThemeControls } from '../../scripts/theme';

  const select = document.querySelector<HTMLSelectElement>(
    '[data-theme-control]',
  );

  if (select) {
    initThemeControls(select);
  }
</script>
