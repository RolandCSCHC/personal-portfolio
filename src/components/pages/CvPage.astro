---
import { cvDownload } from '../../data/assets';
import { pageTitle } from '../../data/profile';
import { getProfile } from '../../i18n/profile';
import type { Locale } from '../../i18n/locales';
import { getUi } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../sections/Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = getProfile(locale);
const ui = getUi(locale);
const cv = cvDownload(locale);
---

<BaseLayout
  title={pageTitle(profile.cv.title)}
  description={cv ? profile.cv.published : profile.cv.unpublished}
  locale={locale}
>
  <Section id="cv" title={profile.cv.title} page>
    {cv ? (
      <>
        <p class="reading-measure">{profile.cv.published}</p>
        <p class="mt-6">
          <a
            class="inline-flex min-h-11 items-center text-accent underline"
            href={cv.href}
            rel="noopener noreferrer"
            target="_blank"
            type="application/pdf"
          >
            {profile.cv.download}
            <span class="sr-only"> {ui.newTab}</span>
          </a>
        </p>
      </>
    ) : (
      <p class="reading-measure text-muted">{profile.cv.unpublished}</p>
    )}
  </Section>
</BaseLayout>
