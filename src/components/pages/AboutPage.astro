---
import { pageTitle } from '../../data/profile';
import { getProfile } from '../../i18n/profile';
import type { Locale } from '../../i18n/locales';
import BaseLayout from '../../layouts/BaseLayout.astro';
import About from '../sections/About.astro';
import Education from '../sections/Education.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = getProfile(locale);
const description = profile.about.paragraphs[0];

if (!description) {
  throw new Error('The about page is missing its description.');
}
---

<BaseLayout
  title={pageTitle(profile.about.title)}
  description={description}
  locale={locale}
>
  <About
    title={profile.about.title}
    paragraphs={profile.about.paragraphs}
    page
  />
  <Education
    title={profile.education.title}
    entries={profile.education.entries}
  />
</BaseLayout>
