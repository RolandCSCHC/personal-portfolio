---
interface Props {
  id: string;
  title: string;
  page?: boolean;
}

const { id, title, page = false } = Astro.props;
const headingId = `${id}-heading`;
const Heading = page ? 'h1' : 'h2';
---

<section
  id={id}
  class:list={['scroll-mt-8', !page && 'border-t border-border']}
  aria-labelledby={headingId}
>
  <div class="page-container py-16 md:py-20">
    <Heading id={headingId}>{title}</Heading>
    <div class="mt-6">
      <slot />
    </div>
  </div>
</section>
