---
import type { SkillGroup } from '../../data/profile';
import Section from './Section.astro';

interface Props {
  title: string;
  groups: SkillGroup[];
}

const { title, groups } = Astro.props;
---

<Section id="skills" title={title}>
  <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {groups.map((group) => (
      <li>
        <h3 class="font-mono text-xs font-normal tracking-wide text-muted">
          {group.title}
        </h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {group.items.map((item) => (
            <li class="rounded-sm border border-border bg-surface px-2.5 py-1 text-sm">
              {item}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</Section>
