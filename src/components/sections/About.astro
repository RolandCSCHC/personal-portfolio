---
import Section from './Section.astro';

interface Props {
  title: string;
  paragraphs: string[];
  page?: boolean;
}

const { title, paragraphs, page = false } = Astro.props;
---

<Section id="about" title={title} page={page}>
  <div class="reading-measure grid gap-4">
    {paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>
</Section>
