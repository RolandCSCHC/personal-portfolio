---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PublicLink from '../PublicLink.astro';
import type { PublicLink as PublicLinkData } from '../../data/profile';

interface Props {
  title: string;
  introduction: string;
  description: string;
  photograph: string;
  portrait: ImageMetadata | null;
  portraitAlt: string;
  cvHref: string | null;
  cvLabel: string;
  projectsHref: string;
  projectsLabel: string;
  contactHref: string;
  contactLabel: string;
  github: PublicLinkData;
  linkedin: PublicLinkData;
}

const {
  title,
  introduction,
  description,
  photograph,
  portrait,
  portraitAlt,
  cvHref,
  cvLabel,
  projectsHref,
  projectsLabel,
  contactHref,
  contactLabel,
  github,
  linkedin,
} = Astro.props;
---

<section aria-labelledby="intro-heading">
  <div class="page-container grid gap-10 py-16 md:py-24 lg:grid-cols-[minmax(0,1fr)_16rem] lg:items-start lg:gap-16">
    <div class="min-w-0">
      <p class="font-mono text-xs tracking-wide text-muted">{title}</p>
      <h1 id="intro-heading" class="mt-3">
        {introduction}
      </h1>
      <p class="reading-measure mt-6">{description}</p>
      <ul class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-x-5 sm:gap-y-2">
        <li>
          <a class="text-accent underline" href={projectsHref}>
            {projectsLabel}
          </a>
        </li>
        <li>
          <a class="text-accent underline" href={contactHref}>
            {contactLabel}
          </a>
        </li>
        {cvHref ? (
          <li>
            <a
              class="text-accent underline"
              href={cvHref}
              type="application/pdf"
            >
              {cvLabel}
            </a>
          </li>
        ) : null}
        <li>
          <PublicLink link={github} />
        </li>
        <li>
          <PublicLink link={linkedin} />
        </li>
      </ul>
    </div>
    <figure class="w-full max-w-64">
      {portrait ? (
        <Picture
          src={portrait}
          alt={portraitAlt}
          widths={[256, 512, 768]}
          sizes="(min-width: 20rem) 16rem, calc(100vw - 2.5rem)"
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          fit="cover"
          position="top"
          priority
          class="aspect-[4/5] h-auto w-full object-cover object-top"
          pictureAttributes={{ class: 'block w-full' }}
        />
      ) : (
        <div class="flex aspect-[4/5] items-center justify-center border border-border bg-surface p-6 text-center">
          <p class="text-sm text-muted">{photograph}</p>
        </div>
      )}
    </figure>
  </div>
</section>
