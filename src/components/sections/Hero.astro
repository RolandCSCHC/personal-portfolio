---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { currentLocale } from '../../i18n/locales';
import { getUi } from '../../i18n/ui';

interface Props {
  title: string;
  introduction: string;
  paragraphs: string[];
  photograph: string;
  portrait: ImageMetadata | null;
  portraitAlt: string;
  cvHref: string | null;
  cvLabel: string;
}

const {
  title,
  introduction,
  paragraphs,
  photograph,
  portrait,
  portraitAlt,
  cvHref,
  cvLabel,
} = Astro.props;
const ui = getUi(currentLocale(Astro.currentLocale));
---

<section aria-labelledby="intro-heading">
  <div class="page-container grid gap-10 py-16 md:py-24 lg:grid-cols-[minmax(0,1fr)_16rem] lg:items-start lg:gap-16">
    <div class="min-w-0">
      <p class="font-mono text-xs tracking-wide text-accent">{title}</p>
      <h1 id="intro-heading" class="mt-3">
        {introduction}
      </h1>
      <div class="reading-measure mt-6 grid gap-4">
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      {cvHref ? (
        <p class="mt-8">
          <a
            class="text-accent underline"
            href={cvHref}
            rel="noopener noreferrer"
            target="_blank"
            type="application/pdf"
          >
            {cvLabel}
            <span class="sr-only"> {ui.newTab}</span>
          </a>
        </p>
      ) : null}
    </div>
    <figure class="w-full max-w-64">
      {portrait ? (
        <Picture
          src={portrait}
          alt={portraitAlt}
          widths={[256, 512, 768]}
          sizes="(min-width: 20rem) 16rem, calc(100vw - 2.5rem)"
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          fit="cover"
          position="top"
          priority
          class="aspect-[4/5] h-auto w-full object-cover object-top"
          pictureAttributes={{ class: 'block w-full' }}
        />
      ) : (
        <div class="flex aspect-[4/5] items-center justify-center border border-border bg-surface p-6 text-center">
          <p class="text-sm text-muted">{photograph}</p>
        </div>
      )}
    </figure>
  </div>
</section>
