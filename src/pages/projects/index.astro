---
import ProjectList from '../../components/projects/ProjectList.astro';
import Section from '../../components/sections/Section.astro';
import { profile } from '../../data/profile';
import { loadProjects } from '../../data/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = await loadProjects();
const description = projects.map((project) => project.data.summary).join(' ');
---

<BaseLayout
  title={`${profile.projects.title} — Roland Schlösser`}
  description={description}
>
  <Section id="projects" title={profile.projects.title} page>
    <ProjectList projects={projects} labels={profile.projects} heading="h2" />
  </Section>
</BaseLayout>
